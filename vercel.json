{
  "buildCommand": "npm run vercel-build",
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1",
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/storage/(.*)", "destination": "/storage/$1" },
    { "source": "/(.*)", "destination": "/api/index.php" }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "public"
}