{
  "version": 2,
  "framework": null,
  "regions": ["sin1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/(build|images|assets|vendor|fonts|favicon\\.ico|robots\\.txt|.*\\.js)(.*)",
      "dest": "/public/$1$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "CACHE_STORE": "array",
    "CACHE_DRIVER": "array",
    "APP_CONFIG_CACHE": "/tmp/laravel-config.php",
    "APP_EVENTS_CACHE": "/tmp/laravel-events.php",
    "APP_PACKAGES_CACHE": "/tmp/laravel-packages.php",
    "APP_ROUTES_CACHE": "/tmp/laravel-routes.php",
    "APP_SERVICES_CACHE": "/tmp/laravel-services.php",
    "VIEW_COMPILED_PATH": "/tmp/laravel-views",
    "PENDING_ORDER_CACHE_STORE": "database",
    "LOG_CHANNEL": "stderr",
    "LOG_LEVEL": "error",
    "SESSION_DRIVER": "database",
    "SESSION_DOMAIN": "",
    "SESSION_SECURE_COOKIE": "true",
    "SESSION_SAME_SITE": "lax"
  },
  "headers": [
    {
      "source": "/build/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
