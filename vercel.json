{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.6.1",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/build/(.*)", "destination": "/public/build/$1" },
    { "source": "/(.*)", "destination": "/api/index.php" }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}