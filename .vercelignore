# Ignore local dependencies (Vercel will install them fresh during the build)
node_modules/
vendor/

# Ignore git and local IDE configurations
.git/
.github/
.idea/
.vscode/

# Ignore Laravel testing and documentation files
tests/
phpunit.xml
README.md

# Ignore local storage caches, logs, and sessions
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*